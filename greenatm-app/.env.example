# ─────────────────────────────────────────────────────────────────────────────
#  ตัวอย่างค่าตั้งค่า — คัดลอกเป็น .env.local แล้วเติมค่าจริงบนเครื่องที่รัน backend
#  ห้าม commit ไฟล์ .env.local · ห้ามพิมพ์ key ลงแชท สกรีนช็อต หรือเอกสาร
# ─────────────────────────────────────────────────────────────────────────────

# dgx | qwen — เลือก provider (แต่ละตัวมี option ของตัวเอง ดู src/lib/llm/providers.ts)
LLM_PROVIDER=qwen

# ต้องลงท้ายด้วย /v1 — โค้ดจะต่อ /chat/completions ให้เอง
# Qwen FPT (ยังไม่ยืนยัน port / path / model list / auth — ดู QWEN-FPT-INTEGRATION.md)
LLM_BASE_URL=http://124.197.18.95:8000/v1
# DGX Spark (ทางหลัก):  http://10.0.63.215:8000/v1   หรือ  http://10.0.63.239:8000/v1

# ชื่อรุ่นที่ served จริง — ต้องยืนยันกับ facilitator หรือจาก GET /v1/models
# qwen3.8-27b  ← ลอกมาจากโน้ต ไม่ใช่ชื่อรุ่นทางการ
# nemotron-3.5-lightning  ← สำหรับ DGX
LLM_MODEL=<EXACT_SERVED_MODEL_ID>

# key จาก facilitator — เติมบนเครื่องเท่านั้น
LLM_API_KEY=<ENTER_LOCALLY>

LLM_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
#  ประตูกันพลาด: endpoint ของ Qwen ที่บันทึกไว้เป็น HTTP ธรรมดา
#  QWEN-FPT-INTEGRATION.md ระบุว่า "ต้องได้ HTTPS endpoint หรือเส้นทางภายใน
#  ที่อนุมัติแล้ว ก่อนส่ง key จริงหรือข้อมูลที่ไม่เปิดเผย"
#
#  โค้ดจะ "ปฏิเสธการส่ง key ข้าม http://" เว้นแต่ตั้งค่าบรรทัดล่างเป็น true
#  → ตั้งเป็น true ก็ต่อเมื่อ facilitator ยืนยันว่าเป็นเส้นทางภายในที่ปลอดภัยแล้ว
#  → ถ้า endpoint ไม่ต้องใช้ key เลย ปล่อย LLM_API_KEY ว่าง แล้วทดสอบได้ตามปกติ
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_INSECURE_LLM_HTTP=false
