# ─────────────────────────────────────────────────────────────────────────────
#  ตัวอย่างค่าตั้งค่า — คัดลอกเป็น .env.local แล้วเติมค่าจริงบนเครื่องที่รัน backend
#  ห้าม commit ไฟล์ .env.local · ห้ามพิมพ์ key ลงแชท สกรีนช็อต หรือเอกสาร
# ─────────────────────────────────────────────────────────────────────────────

# dgx | qwen — ตัวที่ใช้ตอนเปิดครั้งแรก
# หลังจากนั้นผู้ดูแลเลือกได้จากหน้าจอ (ไฟสถานะมุมขวาบน) ค่าที่เลือกไว้มาก่อนค่านี้
LLM_PROVIDER=dgx

# ── ตั้งค่าทีละ provider · base URL ต้องลงท้าย /v1 (โค้ดต่อ /chat/completions ให้เอง) ──
# DGX Spark — ต้องอยู่ในเครือข่ายเวิร์กช็อปถึงจะยิงถึง
LLM_DGX_BASE_URL=http://10.0.63.215:8000/v1
LLM_DGX_MODEL=nemotron-3.5-lightning
# LLM_DGX_API_KEY=<ENTER_LOCALLY>     ← endpoint นี้ไม่ต้องใช้ key

# Qwen บน FPT Cloud — IP อัปเดตจาก facilitator 16 ก.ย. 2569
LLM_QWEN_BASE_URL=http://124.197.18.248:8000/v1
LLM_QWEN_MODEL=qwen3.8-27b
# LLM_QWEN_API_KEY=<ENTER_LOCALLY>

# ── แบบเดิม (ยังใช้ได้) ──────────────────────────────────────────────────────
# ถ้าไม่ตั้ง LLM_<PROVIDER>_* ข้างบน โค้ดจะถอยมาใช้สามบรรทัดนี้
# **เฉพาะเมื่อ LLM_PROVIDER ชี้มาที่ provider ตัวนั้น** ไม่งั้นสลับ provider แล้ว
# จะได้ URL ของอีกตัวติดมาโดยไม่รู้ตัว
# LLM_BASE_URL=<FACILITATOR_CONFIRMED_BASE_URL_ENDING_IN_V1>
# LLM_MODEL=<EXACT_SERVED_MODEL_ID>
# LLM_API_KEY=<ENTER_LOCALLY>

LLM_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
#  ประตูกันพลาด: endpoint ของ Qwen ที่บันทึกไว้เป็น HTTP ธรรมดา
#  QWEN-FPT-INTEGRATION.md ระบุว่า "ต้องได้ HTTPS endpoint หรือเส้นทางภายใน
#  ที่อนุมัติแล้ว ก่อนส่ง key จริงหรือข้อมูลที่ไม่เปิดเผย"
#
#  โค้ดจะ "ปฏิเสธการส่ง key ข้าม http://" เว้นแต่ตั้งค่าบรรทัดล่างเป็น true
#  → ตั้งเป็น true ก็ต่อเมื่อ facilitator ยืนยันว่าเป็นเส้นทางภายในที่ปลอดภัยแล้ว
#  → ถ้า endpoint ไม่ต้องใช้ key เลย ปล่อย LLM_API_KEY ว่าง แล้วทดสอบได้ตามปกติ
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_INSECURE_LLM_HTTP=false
